# /etc/systemd/system/reshis-avia.service — альтернатива PM2
[Unit]
Description=Reshis Avia forecast
After=network.target

[Service]
Type=simple
User=reshis
WorkingDirectory=/opt/reshis-avia/app
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3000
Environment=TRUST_PROXY=loopback
Environment=COOKIE_SECURE=auto
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning dist/node/server/index.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
