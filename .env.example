# Скопируйте в .env и поправьте: npm start читает .env автоматически (если файл есть).
# Переменные окружения хостинга имеют приоритет над .env. Все переменные необязательны.

# --- Сервер ---
NODE_ENV=production
# Порт и адрес, на которых слушает сервер
PORT=3000
HOST=0.0.0.0
# За обратным прокси укажите его IP или подсеть. Для nginx на том же сервере подходит loopback.
# Без этого сервер не определит HTTPS и реальный IP клиента, и лимит попыток станет общим для всех.
# Значение true не используйте: тогда IP можно подделать заголовком X-Forwarded-For.
TRUST_PROXY=loopback
# auto — флаг Secure у cookie ставится, если запрос пришёл по HTTPS.
# true — всегда (и включается HSTS). false — никогда (только для локального HTTP).
COOKIE_SECURE=auto
LOG_LEVEL=info

# --- Данные прогноза ---
# Папка с seasonal_forecast.csv и routes.csv (по умолчанию ./data)
DATA_DIR=data
# Или явные пути к файлам (перекрывают DATA_DIR). Пример для своего прогноза:
# FORECAST_PATH=data/Иванов_my_forecast.csv
# ROUTES_PATH=data/routes.csv
# Как часто проверять, не заменили ли файлы (мс). Замена подхватывается без перезапуска.
DATA_CHECK_INTERVAL_MS=2000

# --- Пользователи ---
# Папка для базы SQLite с аккаунтами и сессиями (нужен постоянный диск)
STORAGE_DIR=storage
# Или полный путь к файлу базы
# DB_PATH=/var/lib/reshis-avia/app.db
# Разрешить самостоятельную регистрацию
ALLOW_REGISTRATION=true
# Срок жизни сессии, часов
SESSION_TTL_HOURS=168
# Попыток входа/регистрации с одного IP в минуту
AUTH_RATE_LIMIT=10
# Владелец сайта создаётся при запуске, если в базе ещё нет администратора.
# Задайте обе переменные. На хостинге задайте пароль как секрет.
# INITIAL_ADMIN_EMAIL=owner@example.com
# INITIAL_ADMIN_PASSWORD=
# Максимальный размер CSV, загружаемого через раздел «Данные», МБ
UPLOAD_MAX_MB=5
# Общий лимит предпросмотров и применений CSV с одного IP за минуту.
ADMIN_UPLOAD_RATE_LIMIT=30
